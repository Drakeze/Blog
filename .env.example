# Thinking Out Loud — environment template
# Copy to .env and fill in. Never commit .env. Full notes: docs/ENV.md
# Run `bun run verify-env` after editing.

#══════════════ MongoDB ══════════════
# Same Atlas cluster as before. The database name in the URI path decides the
# target: local + Vercel Preview → blog_db_dev, Vercel Production → blog_db.
DATABASE_URL="mongodb+srv://USER:PASS@cluster.mongodb.net/blog_db_dev?retryWrites=true&w=majority"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

#══════════════ Resend ══════════════
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="Thinking Out Loud <hello@blog.drakeze.com>"
RESEND_REPLY_TO_EMAIL=""
# live = actually send · log = write to console + email_logs, don't send · off = no-op
EMAIL_DELIVERY_MODE="log"
AUTO_SEND_POST_EMAILS="false"

#══════════════ Cloudflare / R2 ══════════════
# Bucket "blog" already exists (WNAM). Create an R2 API token:
# Cloudflare dashboard → R2 → Manage API Tokens → Create → Object Read & Write,
# scoped to the "blog" bucket. That page shows the Account ID + the key pair.
CLOUDFLARE_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="blog"
# Public read URL. Connect a custom domain (R2 → blog → Settings → Custom Domains)
# → images-blog.drakeze.com, or use the bucket's r2.dev subdomain for dev.
NEXT_PUBLIC_R2_PUBLIC_URL="https://images-blog.drakeze.com"

#══════════════ Clerk — Test ══════════════
# Same Clerk instance as the live site. Test keys for local dev.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

#══════════════ Clerk — Live (set in Vercel Production only) ══════════════
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_live_..."
# CLERK_SECRET_KEY="sk_live_..."

#══════════════ Admin allowlist ══════════════
# Comma-separated. Either match grants admin.
CLERK_ADMIN_EMAILS="asheadworking@gmail.com"
CLERK_ADMIN_USER_IDS=""

#══════════════ PostHog ══════════════
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

#══════════════ Claude MCP connector ══════════════
# Shared secret the MCP Worker presents to this app's /api/mcp routes.
# Generate: openssl rand -hex 32
MCP_SERVICE_SECRET=""
# Legacy bearer for the old POST /api/posts/draft path (optional).
DRAFT_API_SECRET=""

#══════════════ Atlas Admin API (for scripts/ensure-atlas-search — Phase 2) ══════════════
ATLAS_PUBLIC_KEY=""
ATLAS_PRIVATE_KEY=""
ATLAS_GROUP_ID=""
ATLAS_CLUSTER_NAME=""
