# Copy to .env.local and fill in. Local dev loads .env.local ONLY.
# Every value must also be set on Vercel (Production + Preview) and kept in sync.
# See docs/ENV.md for what each var is. Check a filled-in env: bun run verify-env

# Core
DATABASE_URL=mongodb://localhost:27017/blog_db
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Clerk auth — publishable + secret key MUST be from the same Clerk instance
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
CLERK_ADMIN_EMAILS=
CLERK_ADMIN_USER_IDS=

# Resend email
RESEND_API_KEY=
RESEND_FROM_EMAIL=Blog <updates@example.com>
RESEND_REPLY_TO_EMAIL=
AUTO_SEND_POST_EMAILS=false

# Draft post API (creating drafts programmatically). Generate: openssl rand -hex 32
DRAFT_API_SECRET=

# Cloudflare R2 image storage
# Create bucket at dash.cloudflare.com → R2 → Create bucket
# Create API token at R2 → Manage R2 API Tokens (Object Read & Write)
# The key pair must be identical here and in the deploy env (Vercel Production);
# a mismatch fails uploads with 403 SignatureDoesNotMatch. Check: bun run verify-r2
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
NEXT_PUBLIC_R2_PUBLIC_URL="https://images.drakeze.com"

# PostHog analytics
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
